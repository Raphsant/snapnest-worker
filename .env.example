# Copy to .env and fill in real values. Never commit .env.
# Variable names match the NestJS backend so the same secrets can be reused.

# Postgres connection string (owned/migrated by the backend; the worker never migrates).
DATABASE_URL=postgresql://user:password@host:5432/snapnest

# SQS queue the backend publishes pipeline jobs to.
PIPELINE_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/000000000000/snapnest-pipeline

# AWS credentials / region for SQS + S3.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# S3 bucket holding source/output media.
S3_BUCKET=snapnest-media

# Anthropic API key for the curate stage.
ANTHROPIC_API_KEY=

# --- Optional tunables (defaults shown; safe to omit) ---
# SQS long-poll wait, seconds (max 20).
# WAIT_TIME_SECONDS=20
# Visibility timeout requested on receive, seconds.
# VISIBILITY_TIMEOUT_SECONDS=900
# Heartbeat interval for extending visibility while a job runs, seconds.
# HEARTBEAT_INTERVAL_SECONDS=600
# Amount each heartbeat extends visibility by, seconds.
# HEARTBEAT_EXTENSION_SECONDS=900
# Root dir for per-job working directories.
# JOB_WORKSPACE_ROOT=/tmp/jobs

# --- Ingest stage: AWS Transcribe (defaults shown; safe to omit) ---
# Transcription language code.
# TRANSCRIBE_LANGUAGE=es-US
# Custom vocabulary name (empty = don't send VocabularyName).
# TRANSCRIBE_VOCABULARY=
# Vocabulary filter name for masking profanity (empty = don't filter/mask).
# TRANSCRIBE_FILTER=
# Seconds between Transcribe status polls.
# TRANSCRIBE_POLL_SECONDS=30

# --- Ingest stage: bleep/beep tuning (ffmpeg) ---
# Seconds of padding added around each masked word.
# BLEEP_PAD=0.15
# Ranges closer than this (seconds) are merged into one beep.
# BLEEP_MERGE_GAP=0.05
# Beep loudness in the mix (0-1).
# BLEEP_VOLUME=0.35
# Beep tone frequency (Hz).
# BLEEP_HZ=1000

# --- Curate stage: Anthropic (defaults shown; safe to omit) ---
# Model used by the STC Curator.
# CURATOR_MODEL=claude-sonnet-4-6
