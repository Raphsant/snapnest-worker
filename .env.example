# Copy to .env and fill in real values. Never commit .env.
#
# docker-compose reads this file verbatim via `env_file: .env`. The compose
# file itself contains ZERO credentials (Dockge renders compose content in the
# UI), so every secret below lives here and only here.
#
# Variable names match the NestJS backend so the same secrets can be reused.

# =============================================================================
# REQUIRED — the worker fails loudly at startup if any of these are missing,
# listing every missing var in one error (see worker/config.py).
# =============================================================================

# Postgres connection string (owned/migrated by the backend; the worker never
# migrates — it only reads/writes PipelineJob rows).
#
# ⚠️ psycopg DIALECT — this is NOT the Prisma string. psycopg requires
#   sslmode=require  and  REJECTS a  schema=public  parameter.
#   Prisma-side strings use  sslmode=no-verify  — NEVER paste that here.
#   Correct shape:
#   postgresql://user:password@host:5432/snapnest?sslmode=require
DATABASE_URL=postgresql://user:password@host:5432/snapnest?sslmode=require

# SQS queue the backend publishes pipeline jobs to (snapnest-pipeline-jobs,
# 3600s visibility timeout). Exactly ONE worker may consume this queue.
PIPELINE_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/000000000000/snapnest-pipeline-jobs

# AWS region for SQS + S3 + Transcribe.
AWS_REGION=us-east-1

# AWS credentials (passed explicitly to the boto3 session — the default
# credential chain is NOT used, so these must be set even on AWS hosts).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# S3 bucket holding source/output media (dev: snapnest-uploads-dev-rs).
S3_BUCKET=snapnest-uploads-dev-rs

# Anthropic API key for the curate + creative stages.
ANTHROPIC_API_KEY=

# =============================================================================
# OPTIONAL — worker/queue tunables (defaults shown; safe to omit entirely).
# =============================================================================

# SQS long-poll wait, seconds (max 20).
# WAIT_TIME_SECONDS=20
# Visibility timeout requested on each receive, seconds.
# VISIBILITY_TIMEOUT_SECONDS=900
# How often a running job extends its SQS visibility, seconds.
# HEARTBEAT_INTERVAL_SECONDS=600
# How much each heartbeat extends visibility by, seconds.
# HEARTBEAT_EXTENSION_SECONDS=900

# Root dir for per-job working directories (<root>/<jobId>). ALL heavy temp I/O
# lands here — yt-dlp multi-GB downloads, ffmpeg intermediates, Higgsfield
# results — and each job dir is deleted when the job finishes. The image sets a
# predictable container default; override this to point at a mounted volume if
# disk pressure ever demands (see docker-compose.yml).
# JOB_WORKSPACE_ROOT=/var/lib/snapnest/jobs

# =============================================================================
# OPTIONAL — ingest stage: AWS Transcribe (defaults shown).
# =============================================================================

# Transcription language code.
# TRANSCRIBE_LANGUAGE=es-US
# Custom vocabulary name (empty = don't send VocabularyName). Prod: stc-trading-es
# TRANSCRIBE_VOCABULARY=
# Vocabulary filter name for masking profanity (empty = don't filter/mask).
# Prod: stc-profanity-es  (filter method is always "mask" — words become ***)
# TRANSCRIBE_FILTER=
# Seconds between Transcribe status polls.
# TRANSCRIBE_POLL_SECONDS=30

# =============================================================================
# OPTIONAL — ingest stage: bleep/beep tuning for the ffmpeg mute+beep pass.
# =============================================================================

# Seconds of padding added around each masked word.
# BLEEP_PAD=0.15
# Ranges closer than this (seconds) are merged into one beep.
# BLEEP_MERGE_GAP=0.05
# Beep loudness in the mix (0-1).
# BLEEP_VOLUME=0.35
# Beep tone frequency (Hz).
# BLEEP_HZ=1000

# =============================================================================
# OPTIONAL — Anthropic stages (defaults shown).
# =============================================================================

# Model used by the STC Curator (curate stage).
# CURATOR_MODEL=claude-sonnet-4-6
# Model used by the creative stage. Inherits CURATOR_MODEL when unset.
# CREATIVE_MODEL=claude-sonnet-4-6

# =============================================================================
# OPTIONAL — Higgsfield (generate stage).
# =============================================================================

# The Higgsfield CLI authenticates via files under $HOME/.config/higgsfield
# (config.json + credentials.json), bind-mounted from the host — NOT via this
# variable. HIGGSFIELD_API_KEY is read ONLY to redact the key from logs; leave
# it unset unless the key appears in CLI output you need scrubbed.
# HIGGSFIELD_API_KEY=
